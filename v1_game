<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>GeoBuilder | Circle Theorem Game - Version 1</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        /* 基础样式 - 支持暗色模式 */
        :root {
            --bg-primary: #0a0f1a;
            --bg-secondary: #111827;
            --card-bg: rgba(30, 41, 59, 0.9);
            --text-primary: #f1f5f9;
            --text-secondary: #94a3b8;
            --accent: #3b82f6;
            --accent-dark: #1e40af;
            --success: #10b981;
            --danger: #ef4444;
            --border: #334155;
            --shadow: 0 4px 6px -1px rgba(0,0,0,0.3);
        }

        [data-theme="light"] {
            --bg-primary: #f1f5f9;
            --bg-secondary: #ffffff;
            --card-bg: rgba(255,255,255,0.95);
            --text-primary: #0f172a;
            --text-secondary: #475569;
            --border: #e2e8f0;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            transition: all 0.3s ease;
        }

        .game-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
            min-height: 100vh;
        }

        /* 头部导航 */
        .top-nav {
            background: var(--card-bg);
            border-radius: 24px;
            padding: 12px 24px;
            margin-bottom: 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            border: 1px solid var(--border);
        }

        .logo-area {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-icon {
            font-size: 28px;
        }

        .logo-text {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--accent);
        }

        .breadcrumb {
            display: flex;
            gap: 8px;
            background: var(--bg-primary);
            padding: 6px 16px;
            border-radius: 40px;
        }

        .breadcrumb-item {
            cursor: pointer;
            color: var(--text-secondary);
            font-size: 0.85rem;
        }

        .breadcrumb-item.active {
            color: var(--accent);
        }

        .controls-group {
            display: flex;
            gap: 8px;
        }

        .icon-btn {
            background: var(--bg-primary);
            border: 1px solid var(--border);
            border-radius: 40px;
            padding: 6px 14px;
            cursor: pointer;
            color: var(--text-primary);
            font-size: 0.8rem;
        }

        .icon-btn:hover {
            background: var(--accent);
            color: white;
        }

        /* 主布局 - 三栏 */
        .main-layout {
            display: grid;
            grid-template-columns: 280px 1fr 280px;
            gap: 20px;
        }

        /* 左侧面板 - 知识点 */
        .left-panel {
            background: var(--card-bg);
            border-radius: 24px;
            padding: 20px;
            border: 1px solid var(--border);
            height: fit-content;
        }

        .section-title {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--accent);
            margin-bottom: 16px;
        }

        /* 难度选择卡片 */
        .difficulty-grid {
            display: grid;
            gap: 10px;
            margin-bottom: 24px;
        }

        .difficulty-card {
            background: var(--bg-primary);
            border-radius: 16px;
            padding: 12px;
            cursor: pointer;
            transition: all 0.2s;
            border: 2px solid transparent;
        }

        .difficulty-card.active {
            border-color: var(--accent);
            background: rgba(59,130,246,0.1);
        }

        .difficulty-card:hover {
            transform: translateX(4px);
        }

        .difficulty-name {
            font-weight: 700;
            font-size: 0.9rem;
        }

        .difficulty-stats {
            font-size: 0.65rem;
            color: var(--text-secondary);
            margin-top: 4px;
        }

        /* 统计卡片 */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            margin: 16px 0;
        }

        .stat-card {
            background: var(--bg-primary);
            border-radius: 16px;
            padding: 12px;
            text-align: center;
        }

        .stat-value {
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--accent);
        }

        .stat-label {
            font-size: 0.65rem;
            color: var(--text-secondary);
        }

        /* 中间游戏区 */
        .game-panel {
            background: var(--card-bg);
            border-radius: 24px;
            padding: 20px;
            border: 1px solid var(--border);
        }

        .challenge-header {
            text-align: center;
            margin-bottom: 16px;
        }

        .challenge-badge {
            display: inline-block;
            background: var(--accent);
            padding: 4px 16px;
            border-radius: 40px;
            font-size: 0.7rem;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .challenge-title {
            font-size: 1.3rem;
            font-weight: 700;
        }

        /* 游戏状态栏 */
        .game-status {
            background: var(--bg-primary);
            border-radius: 16px;
            padding: 10px 16px;
            margin-bottom: 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .timer {
            font-size: 1.3rem;
            font-weight: 700;
            font-family: monospace;
            color: var(--accent);
        }

        .timer.warning {
            color: var(--danger);
        }

        .lives {
            display: flex;
            gap: 4px;
        }

        /* 画布区 */
        .canvas-area {
            background: var(--bg-primary);
            border-radius: 20px;
            padding: 16px;
            text-align: center;
        }

        canvas {
            background: var(--bg-secondary);
            border-radius: 16px;
            box-shadow: var(--shadow);
            cursor: crosshair;
            max-width: 100%;
            height: auto;
        }

        canvas.shake {
            animation: shake 0.3s ease;
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-4px); }
            75% { transform: translateX(4px); }
        }

        canvas.celebrate {
            animation: celebrate 0.5s ease;
        }

        @keyframes celebrate {
            0% { transform: scale(1); }
            50% { transform: scale(1.02); box-shadow: 0 0 20px var(--accent); }
            100% { transform: scale(1); }
        }

        /* 工具条 */
        .toolbar {
            display: flex;
            gap: 10px;
            justify-content: center;
            margin: 16px 0;
            flex-wrap: wrap;
        }

        .tool-btn {
            background: var(--bg-primary);
            border: 2px solid var(--border);
            border-radius: 40px;
            padding: 8px 20px;
            cursor: pointer;
            transition: all 0.2s;
            color: var(--text-primary);
        }

        .tool-btn.active {
            background: var(--accent);
            border-color: var(--accent);
            color: white;
        }

        /* 目标提示 */
        .goal-hint {
            background: linear-gradient(135deg, var(--accent), var(--accent-dark));
            border-radius: 16px;
            padding: 10px 16px;
            margin: 12px 0;
            text-align: center;
            font-size: 0.85rem;
        }

        /* 操作按钮 */
        .action-buttons {
            display: flex;
            gap: 12px;
            justify-content: center;
            margin-top: 16px;
        }

        .primary-btn {
            background: linear-gradient(135deg, var(--accent), var(--accent-dark));
            color: white;
            border: none;
            padding: 10px 24px;
            border-radius: 40px;
            font-weight: 600;
            cursor: pointer;
        }

        .primary-btn:hover {
            transform: translateY(-2px);
        }

        /* 右侧AI面板 - 简化版 */
        .right-panel {
            background: linear-gradient(135deg, var(--accent-dark), var(--accent));
            border-radius: 24px;
            padding: 20px;
            color: white;
            height: fit-content;
        }

        .ai-message {
            background: rgba(255,255,255,0.15);
            padding: 12px;
            border-radius: 16px;
            margin: 12px 0;
            font-size: 0.85rem;
        }

        /* 模态框 */
        .modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.7);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s;
        }

        .modal.active {
            opacity: 1;
            visibility: visible;
        }

        .modal-content {
            background: var(--card-bg);
            border-radius: 32px;
            padding: 32px;
            text-align: center;
            max-width: 400px;
        }

        /* 响应式 */
        @media (max-width: 1000px) {
            .main-layout {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="game-container">
        <!-- 头部导航 -->
        <div class="top-nav">
            <div class="logo-area">
                <span class="logo-icon">⚪</span>
                <span class="logo-text">GeoBuilder | Circle Theorem Game</span>
            </div>
            <div class="breadcrumb">
                <span class="breadcrumb-item">🏠 Home</span>
                <span class="breadcrumb-sep">/</span>
                <span class="breadcrumb-item active">🎮 Geometry Challenge</span>
            </div>
            <div class="controls-group">
                <button class="icon-btn" id="themeToggleBtn">🌙 Dark</button>
                <button class="icon-btn" id="langToggleBtn">🌐 中文</button>
            </div>
        </div>

        <div class="main-layout">
            <!-- 左侧：知识点选择 -->
            <div class="left-panel">
                <div class="section-title">📚 Circle Theorems</div>
                <div class="difficulty-grid" id="theoremGrid"></div>

                <div class="section-title" style="margin-top: 20px;">📊 Game Stats</div>
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-value" id="scoreValue">0</div>
                        <div class="stat-label">Score</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-value" id="streakValue">0</div>
                        <div class="stat-label">Combo</div>
                    </div>
                </div>
            </div>

            <!-- 中间：游戏区 -->
            <div class="game-panel">
                <div class="challenge-header">
                    <span class="challenge-badge" id="levelBadge">🎯 Challenge 1/4</span>
                    <h2 class="challenge-title" id="challengeTitle">Central Angle Theorem</h2>
                </div>

                <div class="game-status">
                    <div class="timer" id="timerDisplay">01:30</div>
                    <div class="score-display" id="targetDisplay">🎯 Target: 2 points</div>
                    <div class="lives" id="livesDisplay">❤️ ❤️ ❤️ ❤️ ❤️</div>
                </div>

                <div class="canvas-area">
                    <canvas id="gameCanvas" width="500" height="450" style="width:100%; height:auto; max-width:500px; aspect-ratio:500/450"></canvas>
                </div>

                <div class="goal-hint" id="goalHint">
                    ⭐ Add 2 points on the circle, then click Verify!
                </div>

                <div class="toolbar">
                    <button class="tool-btn" data-tool="point">📍 Point</button>
                    <button class="tool-btn" data-tool="line">📏 Line</button>
                    <button class="tool-btn" data-tool="clear">🧹 Clear</button>
                </div>

                <div class="action-buttons">
                    <button class="primary-btn" id="submitBtn">✨ Verify ✨</button>
                    <button class="primary-btn" id="resetBtn" style="background: var(--danger);">🔄 Reset</button>
                </div>
            </div>

            <!-- 右侧：AI助手简化版 -->
            <div class="right-panel">
                <h4>🤖 AI Assistant</h4>
                <div class="ai-message" id="aiMessage">
                    💡 Need help? Click the theorem on the left to learn!
                </div>
                <button id="hintBtn" style="background: rgba(255,255,255,0.2); border: none; padding: 8px 16px; border-radius: 40px; color: white; cursor: pointer; width: 100%;">💡 Get Hint</button>
            </div>
        </div>
    </div>

    <!-- 胜利模态框 -->
    <div class="modal" id="victoryModal">
        <div class="modal-content">
            <div style="font-size: 48px;">🏆</div>
            <h2>Challenge Complete!</h2>
            <p id="modalMessage">Perfect! +100 points</p>
            <button class="primary-btn" id="nextBtn" style="margin-top: 16px;">Next Challenge →</button>
        </div>
    </div>

    <script>
        // ========== 语言包 ==========
        const translations = {
            en: {
                theorems: [
                    "Central Angle Theorem",
                    "Inscribed Angle Theorem",
                    "Thales' Theorem",
                    "Tangent Theorem"
                ],
                hints: [
                    "Add 2 points on the circle, connect to center",
                    "Add 3 points, vertex on circle",
                    "Draw a diameter, find a point on circle",
                    "Add point, draw line perpendicular to radius"
                ],
                formulas: [
                    "∠AOB = measure of arc AB",
                    "∠ACB = ½ × arc AB",
                    "Angle in semicircle = 90°",
                    "Tangent ⟂ Radius"
                ],
                goal: "⭐ Goal: {hint}",
                correct: "✓ Correct! +{score}",
                wrong: "✗ Wrong! Need {need} more points",
                gameWin: "🎉 You completed all challenges! 🎉"
            },
            zh: {
                theorems: [
                    "圆心角定理",
                    "圆周角定理",
                    "直径定理",
                    "切线定理"
                ],
                hints: [
                    "在圆上添加2个点，连接圆心",
                    "在圆上添加3个点，顶点在圆上",
                    "画一条直径，找圆上的点",
                    "添加点，画垂直于半径的线"
                ],
                formulas: [
                    "∠AOB = 弧AB度数",
                    "∠ACB = ½ × 弧AB",
                    "直径所对圆周角 = 90°",
                    "切线 ⊥ 半径"
                ],
                goal: "⭐ 目标：{hint}",
                correct: "✓ 正确！+{score}分",
                wrong: "✗ 错误！还需要{need}个点",
                gameWin: "🎉 恭喜完成所有挑战！🎉"
            }
        };

        // 挑战数据（4个基础定理）
        const challenges = [
            { nameKey: 0, hintKey: 0, formulaKey: 0 },
            { nameKey: 1, hintKey: 1, formulaKey: 1 },
            { nameKey: 2, hintKey: 2, formulaKey: 2 },
            { nameKey: 3, hintKey: 3, formulaKey: 3 }
        ];

        // 难度配置（入门级）
        const difficulties = [
            { id: 'easy', name: '🌱 Beginner', targetPoints: 2, timeLimit: 90, lives: 5, multiplier: 1.0 }
        ];

        // 游戏状态
        let currentLang = 'en';
        let currentTheme = 'dark';
        let currentDifficulty = difficulties[0];
        let currentChallenge = 0;
        let score = 0;
        let streak = 0;
        let lives = 5;
        let timeLeft = 90;
        let timerInterval = null;
        let gameActive = true;
        let completedChallenges = [];
        
        let canvas, ctx;
        let centerX, centerY, radius;
        let points = [];
        let lines = [];
        let currentTool = 'point';
        let tempLineStart = null;

        // 辅助函数
        function t(key, ...args) {
            let text = translations[currentLang][key];
            if (args.length && typeof text === 'string') {
                text = text.replace('{score}', args[0]);
                text = text.replace('{need}', args[0]);
                text = text.replace('{hint}', args[0]);
            }
            return text || key;
        }

        function getCurrentHint() {
            const idx = challenges[currentChallenge].hintKey;
            return translations[currentLang].hints[idx];
        }

        function getCurrentFormula() {
            const idx = challenges[currentChallenge].formulaKey;
            return translations[currentLang].formulas[idx];
        }

        function getCurrentTheoremName() {
            const idx = challenges[currentChallenge].nameKey;
            return translations[currentLang].theorems[idx];
        }

        // 初始化
        function init() {
            canvas = document.getElementById('gameCanvas');
            ctx = canvas.getContext('2d');
            canvas.width = 500;
            canvas.height = 450;
            centerX = canvas.width / 2;
            centerY = canvas.height / 2;
            radius = 150;
            
            renderTheoremGrid();
            setupEventListeners();
            drawBaseCircle();
            loadSavedSettings();
            updateUI();
            startTimer();
        }

        function renderTheoremGrid() {
            const grid = document.getElementById('theoremGrid');
            grid.innerHTML = '';
            translations[currentLang].theorems.forEach((name, idx) => {
                const card = document.createElement('div');
                card.className = `difficulty-card ${currentChallenge === idx ? 'active' : ''}`;
                card.innerHTML = `
                    <div class="difficulty-name">${name}</div>
                    <div class="difficulty-stats">${translations[currentLang].hints[idx].substring(0, 30)}...</div>
                `;
                card.onclick = () => {
                    currentChallenge = idx;
                    resetChallenge();
                    renderTheoremGrid();
                    updateUI();
                };
                grid.appendChild(card);
            });
        }

        function setupEventListeners() {
            // 工具选择
            document.querySelectorAll('.tool-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    document.querySelectorAll('.tool-btn').forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    currentTool = btn.dataset.tool;
                });
            });
            
            // 画布点击
            canvas.addEventListener('click', handleCanvasClick);
            
            // 按钮
            document.getElementById('submitBtn').addEventListener('click', submitConstruction);
            document.getElementById('resetBtn').addEventListener('click', resetChallenge);
            document.getElementById('nextBtn').addEventListener('click', nextChallenge);
            document.getElementById('hintBtn').addEventListener('click', () => {
                showToast(`💡 ${getCurrentHint()}`, 'info');
                const aiMsg = document.getElementById('aiMessage');
                aiMsg.innerHTML = `💡 ${getCurrentHint()}<br>📐 ${getCurrentFormula()}`;
            });
            document.getElementById('themeToggleBtn').addEventListener('click', toggleTheme);
            document.getElementById('langToggleBtn').addEventListener('click', toggleLang);
        }

        function handleCanvasClick(e) {
            if (!gameActive) return;
            
            const rect = canvas.getBoundingClientRect();
            const scaleX = canvas.width / rect.width;
            const scaleY = canvas.height / rect.height;
            const x = (e.clientX - rect.left) * scaleX;
            const y = (e.clientY - rect.top) * scaleY;
            
            switch(currentTool) {
                case 'point':
                    const distToCenter = Math.hypot(x - centerX, y - centerY);
                    if (distToCenter <= radius + 20) {
                        const label = String.fromCharCode(65 + points.length % 26);
                        points.push({ x, y, label });
                        drawBaseCircle();
                        checkAutoComplete();
                    } else {
                        canvas.classList.add('shake');
                        setTimeout(() => canvas.classList.remove('shake'), 300);
                    }
                    break;
                case 'line':
                    if (tempLineStart) {
                        lines.push({ x1: tempLineStart.x, y1: tempLineStart.y, x2: x, y2: y });
                        tempLineStart = null;
                        drawBaseCircle();
                        checkAutoComplete();
                    } else {
                        tempLineStart = { x, y };
                    }
                    break;
                case 'clear':
                    points = [];
                    lines = [];
                    tempLineStart = null;
                    drawBaseCircle();
                    break;
            }
        }

        function checkAutoComplete() {
            const targetPoints = currentDifficulty.targetPoints;
            if (points.length >= targetPoints) {
                submitConstruction();
            }
        }

        function submitConstruction() {
            if (!gameActive) return;
            
            const targetPoints = currentDifficulty.targetPoints;
            let isValid = points.length >= targetPoints;
            
            if (isValid) {
                const addScore = Math.floor(100 * currentDifficulty.multiplier);
                score += addScore;
                streak++;
                
                if (!completedChallenges.includes(currentChallenge)) {
                    completedChallenges.push(currentChallenge);
                }
                
                if (score > (localStorage.getItem('highScore') || 0)) {
                    localStorage.setItem('highScore', score);
                }
                
                updateUI();
                showToast(t('correct', addScore), 'success');
                
                canvas.classList.add('celebrate');
                setTimeout(() => canvas.classList.remove('celebrate'), 500);
                
                if (currentChallenge < challenges.length - 1) {
                    document.getElementById('victoryModal').classList.add('active');
                } else {
                    showToast(t('gameWin'), 'success');
                    gameActive = false;
                    if (timerInterval) clearInterval(timerInterval);
                }
            } else {
                streak = 0;
                lives--;
                updateUI();
                
                canvas.classList.add('shake');
                setTimeout(() => canvas.classList.remove('shake'), 300);
                
                const need = targetPoints - points.length;
                showToast(t('wrong', need), 'error');
                
                if (lives <= 0) {
                    gameActive = false;
                    showToast('Game Over! Reset challenge.', 'error');
                    if (timerInterval) clearInterval(timerInterval);
                }
            }
        }

        function nextChallenge() {
            document.getElementById('victoryModal').classList.remove('active');
            if (currentChallenge < challenges.length - 1) {
                currentChallenge++;
                resetChallenge();
                renderTheoremGrid();
            }
        }

        function resetChallenge() {
            points = [];
            lines = [];
            tempLineStart = null;
            gameActive = true;
            drawBaseCircle();
            updateUI();
            restartTimer();
        }

        function drawBaseCircle() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            // 绘制网格
            ctx.save();
            ctx.strokeStyle = 'rgba(100,100,100,0.2)';
            ctx.lineWidth = 0.5;
            for (let i = 0; i < canvas.width; i += 30) {
                ctx.beginPath();
                ctx.moveTo(i, 0);
                ctx.lineTo(i, canvas.height);
                ctx.stroke();
                ctx.beginPath();
                ctx.moveTo(0, i);
                ctx.lineTo(canvas.width, i);
                ctx.stroke();
            }
            
            // 绘制圆
            ctx.beginPath();
            ctx.arc(centerX, centerY, radius, 0, Math.PI * 2);
            ctx.strokeStyle = getComputedStyle(document.documentElement).getPropertyValue('--accent') || '#3b82f6';
            ctx.lineWidth = 3;
            ctx.stroke();
            
            // 绘制圆心
            ctx.beginPath();
            ctx.arc(centerX, centerY, 4, 0, Math.PI * 2);
            ctx.fillStyle = '#ef4444';
            ctx.fill();
            ctx.fillStyle = getComputedStyle(document.documentElement).getPropertyValue('--text-primary') || '#333';
            ctx.font = 'bold 12px Arial';
            ctx.fillText('O', centerX + 8, centerY - 5);
            
            ctx.restore();
            
            // 绘制点
            points.forEach(point => {
                ctx.beginPath();
                ctx.arc(point.x, point.y, 5, 0, Math.PI * 2);
                ctx.fillStyle = getComputedStyle(document.documentElement).getPropertyValue('--accent') || '#3b82f6';
                ctx.fill();
                ctx.fillStyle = 'white';
                ctx.font = 'bold 10px Arial';
                ctx.fillText(point.label, point.x - 3, point.y - 5);
            });
            
            // 绘制线段
            lines.forEach(line => {
                ctx.beginPath();
                ctx.moveTo(line.x1, line.y1);
                ctx.lineTo(line.x2, line.y2);
                ctx.strokeStyle = '#10b981';
                ctx.lineWidth = 2;
                ctx.stroke();
            });
        }

        function startTimer() {
            if (timerInterval) clearInterval(timerInterval);
            timerInterval = setInterval(() => {
                if (!gameActive) return;
                if (timeLeft <= 0) {
                    gameActive = false;
                    clearInterval(timerInterval);
                    showToast('Time\'s up!', 'error');
                } else {
                    timeLeft--;
                    const minutes = Math.floor(timeLeft / 60);
                    const seconds = timeLeft % 60;
                    const timerDisplay = document.getElementById('timerDisplay');
                    timerDisplay.textContent = `${minutes.toString().padStart(2,'0')}:${seconds.toString().padStart(2,'0')}`;
                    
                    if (timeLeft <= 10) {
                        timerDisplay.classList.add('warning');
                    } else {
                        timerDisplay.classList.remove('warning');
                    }
                }
            }, 1000);
        }

        function restartTimer() {
            if (timerInterval) clearInterval(timerInterval);
            timeLeft = currentDifficulty.timeLimit;
            startTimer();
        }

        function updateUI() {
            const targetPoints = currentDifficulty.targetPoints;
            document.getElementById('targetDisplay').innerHTML = `🎯 Target: ${targetPoints} points`;
            document.getElementById('scoreValue').textContent = score;
            document.getElementById('streakValue').textContent = streak;
            
            const livesDisplay = document.getElementById('livesDisplay');
            let hearts = '';
            for (let i = 0; i < currentDifficulty.lives; i++) {
                hearts += i < lives ? '❤️ ' : '🖤 ';
            }
            livesDisplay.innerHTML = hearts;
            
            document.getElementById('levelBadge').innerHTML = `🎯 Challenge ${currentChallenge + 1}/${challenges.length}`;
            document.getElementById('challengeTitle').textContent = getCurrentTheoremName();
            
            const goalHint = document.getElementById('goalHint');
            goalHint.innerHTML = t('goal', getCurrentHint());
        }

        function showToast(msg, type) {
            const toast = document.createElement('div');
            toast.style.cssText = `
                position: fixed;
                bottom: 30px;
                left: 50%;
                transform: translateX(-50%);
                background: ${type === 'error' ? '#ef4444' : type === 'success' ? '#10b981' : '#f59e0b'};
                color: white;
                padding: 10px 20px;
                border-radius: 40px;
                font-weight: 600;
                z-index: 2000;
                font-size: 0.85rem;
            `;
            toast.textContent = msg;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 2000);
        }

        function toggleTheme() {
            currentTheme = currentTheme === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', currentTheme);
            document.getElementById('themeToggleBtn').innerHTML = currentTheme === 'dark' ? '🌙 Dark' : '☀️ Light';
            drawBaseCircle();
        }

        function toggleLang() {
            currentLang = currentLang === 'en' ? 'zh' : 'en';
            document.getElementById('langToggleBtn').innerHTML = currentLang === 'en' ? '🌐 中文' : '🌐 English';
            renderTheoremGrid();
            updateUI();
            drawBaseCircle();
        }

        function loadSavedSettings() {
            const savedTheme = localStorage.getItem('geo_theme_v1');
            if (savedTheme) {
                currentTheme = savedTheme;
                document.documentElement.setAttribute('data-theme', currentTheme);
                document.getElementById('themeToggleBtn').innerHTML = currentTheme === 'dark' ? '🌙 Dark' : '☀️ Light';
            }
        }

        window.onload = init;
    </script>
</body>
</html>
