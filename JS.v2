// 全局变量
let currentLang = "zh";
let currentLevel = "";
let currentQuestionCount = 0;
let currentTime = 0;
let countdownTimer = null;
let questions = [];
let userAnswers = {};
let score = 0;
let hintUsed = {};
let wrongQuestions = [];
let historyRecords = JSON.parse(localStorage.getItem("quizHistory")) || [];
let wrongNotebook = JSON.parse(localStorage.getItem("wrongNotebook")) || [];

// 页面加载初始化
window.onload = function() {
    // 清除旧的错误数据（避免缓存导致的显示问题）
    localStorage.removeItem("wrongNotebook");
    localStorage.removeItem("quizHistory");
    wrongNotebook = [];
    historyRecords = [];
    
    initLang();
    initTheme();
    initFontSize();
    renderHistory();
    renderNotebook();
    bindEvents();
};

// 初始化所有语言文字（确保100%覆盖）
function initLang() {
    // 页面标题
    document.getElementById("page-title").textContent = langData[currentLang].pageTitle;
    // 面包屑
    document.getElementById("breadcrumb-home").textContent = langData[currentLang].breadcrumbHome;
    document.getElementById("breadcrumb-quiz").textContent = langData[currentLang].breadcrumbQuiz;
    // 等级选择页面
    document.getElementById("level-title").textContent = langData[currentLang].levelTitle;
    document.getElementById("rule-title").textContent = langData[currentLang].ruleTitle;
    document.getElementById("rule-list").innerHTML = langData[currentLang].ruleList.map(item => `<li>${item}</li>`).join("");
    // 等级卡片
    document.getElementById("badge-basic").textContent = langData[currentLang].badgeBasic;
    document.getElementById("basic-desc").innerHTML = langData[currentLang].basicDesc;
    document.getElementById("basic-info").textContent = langData[currentLang].basicInfo;
    document.getElementById("start-basic").textContent = langData[currentLang].startBasic;
    document.getElementById("badge-advanced").textContent = langData[currentLang].badgeAdvanced;
    document.getElementById("advanced-desc").innerHTML = langData[currentLang].advancedDesc;
    document.getElementById("advanced-info").textContent = langData[currentLang].advancedInfo;
    document.getElementById("start-advanced").textContent = langData[currentLang].startAdvanced;
    document.getElementById("badge-challenge").textContent = langData[currentLang].badgeChallenge;
    document.getElementById("challenge-desc").innerHTML = langData[currentLang].challengeDesc;
    document.getElementById("challenge-info").textContent = langData[currentLang].challengeInfo;
    document.getElementById("start-challenge").textContent = langData[currentLang].startChallenge;
    // 历史记录+错题本入口
    document.getElementById("history-title").textContent = langData[currentLang].historyTitle;
    document.getElementById("history-list").textContent = historyRecords.length === 0 ? langData[currentLang].noHistory : "";
    document.getElementById("notebook-btn-text").textContent = langData[currentLang].notebookBtnText;
    // 答题页面按钮
    document.getElementById("quit-btn-text").textContent = langData[currentLang].quitBtnText;
    document.getElementById("hint-btn-text").textContent = langData[currentLang].hintBtnText;
    document.getElementById("prev-btn-text").textContent = langData[currentLang].prevBtnText;
    document.getElementById("next-btn-text").textContent = langData[currentLang].nextBtnText;
    document.getElementById("submit-btn-text").textContent = langData[currentLang].submitBtnText;
    // 结果页面
    document.getElementById("result-title").textContent = langData[currentLang].resultTitle;
    document.getElementById("score-text").textContent = langData[currentLang].scoreText;
    document.getElementById("replay-btn-text").textContent = langData[currentLang].replayBtnText;
    document.getElementById("view-wrong-btn-text").textContent = langData[currentLang].viewWrongBtnText;
    document.getElementById("back-level-btn-text").textContent = langData[currentLang].backLevelBtnText;
    // 错题本页面
    document.getElementById("notebook-title").textContent = langData[currentLang].notebookTitle;
    document.getElementById("back-notebook-btn-text").textContent = langData[currentLang].backNotebookBtnText;
    document.getElementById("notebook-list").textContent = wrongNotebook.length === 0 ? langData[currentLang].noNotebook : "";
    // 底部
    document.getElementById("ad-text").textContent = langData[currentLang].adText;
    document.getElementById("copyright-text").textContent = langData[currentLang].copyrightText;
}

// 切换语言（全页面强制更新，无残留）
function switchLang(lang) {
    currentLang = lang;
    // 切换按钮样式
    document.querySelectorAll(".lang-btn").forEach(btn => btn.classList.remove("active"));
    document.getElementById(`lang-${lang}`).classList.add("active");
    
    // 强制更新所有文字
    initLang();
    
    // 实时更新当前页面
    if (document.getElementById("quiz-page").classList.contains("active")) {
        updateQuizPageLang();
        renderQuestion(currentQuestionCount);
    }
    if (document.getElementById("result-page").classList.contains("active")) {
        renderResult();
    }
    if (document.getElementById("notebook-page").classList.contains("active")) {
        renderNotebook();
    }
    if (document.getElementById("level-selection").classList.contains("active")) {
        renderHistory();
    }
}

// 更新答题页面等级名称
function updateQuizPageLang() {
    const levelName = currentLevel === "basic" ? langData[currentLang].quizLevelBasic :
                      currentLevel === "advanced" ? langData[currentLang].quizLevelAdvanced :
                      langData[currentLang].quizLevelChallenge;
    document.getElementById("quiz-level-name").textContent = levelName;
}

// 主题切换
function initTheme() {
    if (localStorage.getItem("darkTheme") === "true") {
        document.body.classList.add("dark");
        document.getElementById("theme-toggle").innerHTML = '<i class="fas fa-sun"></i>';
    }
}
function toggleTheme() {
    const isDark = document.body.classList.toggle("dark");
    localStorage.setItem("darkTheme", isDark);
    document.getElementById("theme-toggle").innerHTML = isDark ? '<i class="fas fa-sun"></i>' : '<i class="fas fa-moon"></i>';
}

// 字号调节
function initFontSize() {
    const fontSize = localStorage.getItem("fontSize") || "normal";
    document.body.classList.add(`font-${fontSize}`);
    document.getElementById(`font-${fontSize}`).classList.add("active");
}
function setFontSize(size) {
    document.body.classList.remove("font-sm", "font-normal", "font-lg");
    document.body.classList.add(`font-${size}`);
    localStorage.setItem("fontSize", size);
    document.querySelectorAll(".header-controls button[id^='font-']").forEach(btn => btn.classList.remove("active"));
    document.getElementById(`font-${size}`).classList.add("active");
}

// 开始测验
function startQuiz(level, count, time) {
    currentLevel = level;
    currentQuestionCount = 0;
    currentTime = time;
    score = 0;
    userAnswers = {};
    hintUsed = {};
    wrongQuestions = [];
    
    // 随机选题（确保不重复）
    questions = shuffle([...questionBank[level]]).slice(0, count);
    
    // 切换页面并初始化
    switchPage("quiz-page");
    initCountdown();
    updateQuizPageLang();
    renderQuestion(0);
    updateQuestionCount();
}

// 渲染题目（确保双语同步）
function renderQuestion(index) {
    if (index < 0 || index >= questions.length) return;
    const q = questions[index];
    
    // 渲染题干（强制使用当前语言）
    document.getElementById("question-title").textContent = `${langData[currentLang].question}${index+1}${langData[currentLang].ti}：${q.title[currentLang]}`;
    const answerArea = document.getElementById("answer-area");
    answerArea.innerHTML = "";
    
    // 清空提示和反馈
    document.getElementById("hint-content").classList.remove("show");
    document.getElementById("hint-content").textContent = "";
    document.getElementById("answer-feedback").style.display = "none";
    
    // 渲染选择题
    if (q.type === "choice") {
        answerArea.innerHTML = `<p>${langData[currentLang].selectAnswer}</p>` + 
            q.options[currentLang].map((opt, i) => `
                <div class="answer-option ${userAnswers[q.id] === opt ? 'selected' : ''}" data-opt="${opt}">
                    <span>${String.fromCharCode(65 + i)}</span>. ${opt}
                </div>
            `).join("");
        
        // 选择题点击事件
        document.querySelectorAll(".answer-option").forEach(option => {
            option.addEventListener("click", function() {
                document.querySelectorAll(".answer-option").forEach(opt => opt.classList.remove("selected", "correct", "wrong"));
                this.classList.add("selected");
                userAnswers[q.id] = this.dataset.opt;
                checkAnswer(q);
            });
        });
    } 
    // 渲染填空题
    else if (q.type === "input") {
        answerArea.innerHTML = `
            <p>${langData[currentLang].inputAnswer}</p>
            <input type="text" class="answer-input" value="${userAnswers[q.id] || ''}">
            <button class="submit-answer-btn">${langData[currentLang].submitBtnText}</button>
        `;
        
        // 填空题提交事件
        document.querySelector(".submit-answer-btn").addEventListener("click", function() {
            userAnswers[q.id] = document.querySelector(".answer-input").value.trim();
            checkAnswer(q);
        });
    }
    
    // 禁用/启用上下题按钮
    document.getElementById("prev-question").disabled = index === 0;
    document.getElementById("next-question").disabled = index === questions.length - 1;
}

// 检查答案并显示反馈（确保解析100%显示）
function checkAnswer(q) {
    const feedback = document.getElementById("answer-feedback");
    const userAns = userAnswers[q.id] || "";
    const isCorrect = userAns === q.answer.toString();
    
    // 强制获取解析（避免undefined）
    const analysis = q.analysis?.[currentLang] || langData[currentLang].defaultAnalysis;
    
    if (isCorrect) {
        feedback.innerHTML = `${langData[currentLang].correctTip}<br>${langData[currentLang].analysisText}${analysis}`;
        feedback.style.color = "var(--success)";
        // 选择题标绿正确选项
        if (q.type === "choice") {
            document.querySelectorAll(".answer-option").forEach(opt => {
                if (opt.dataset.opt === q.answer) opt.classList.add("correct");
            });
        }
    } else {
        const correctAnswer = q.answer || langData[currentLang].rightAnswer + "无";
        feedback.innerHTML = `${langData[currentLang].wrongTip}<br>${langData[currentLang].rightAnswer}${correctAnswer}<br>${langData[currentLang].analysisText}${analysis}`;
        feedback.style.color = "var(--danger)";
        // 选择题标红错误、标绿正确
        if (q.type === "choice") {
            document.querySelectorAll(".answer-option").forEach(opt => {
                if (opt.dataset.opt === userAns) opt.classList.add("wrong");
                if (opt.dataset.opt === q.answer) opt.classList.add("correct");
            });
        }
    }
    feedback.style.display = "block";
}

// 倒计时
function initCountdown() {
    clearInterval(countdownTimer);
    updateCountdown();
    countdownTimer = setInterval(() => {
        currentTime--;
        updateCountdown();
        if (currentTime <= 0) {
            clearInterval(countdownTimer);
            submitQuiz();
        }
    }, 1000);
}
function updateCountdown() {
    const min = Math.floor(currentTime / 60);
    const sec = currentTime % 60;
    document.getElementById("countdown").textContent = `${min.toString().padStart(2, '0')}:${sec.toString().padStart(2, '0')}`;
}

// 切换题目
function changeQuestion(type) {
    const input = document.querySelector(".answer-input");
    if (input) {
        userAnswers[questions[currentQuestionCount].id] = input.value.trim();
    }
    currentQuestionCount = type === "prev" ? currentQuestionCount - 1 : currentQuestionCount + 1;
    renderQuestion(currentQuestionCount);
    updateQuestionCount();
}

// 显示提示
function showHint() {
    const q = questions[currentQuestionCount];
    if (!q || hintUsed[q.id]) return;
    hintUsed[q.id] = true;
    document.getElementById("hint-content").textContent = `${langData[currentLang].hintContent}${q.hint[currentLang]}`;
    document.getElementById("hint-content").classList.add("show");
}

// 提交测验
function submitQuiz() {
    if (!confirm(langData[currentLang].quizSubmit)) return;
    clearInterval(countdownTimer);
    
    // 判分
    questions.forEach(q => {
        const userAns = userAnswers[q.id] || "";
        const isCorrect = userAns === q.answer.toString();
        
        if (isCorrect) {
            score += hintUsed[q.id] ? 8 : 10;
        } else {
            wrongQuestions.push(q);
            // 错题去重
            if (!wrongNotebook.some(item => item.id === q.id)) {
                wrongNotebook.push(q);
            }
        }
    });
    
    // 保存错题本（强制更新）
    localStorage.setItem("wrongNotebook", JSON.stringify(wrongNotebook));
    saveHistory();
    renderResult();
    switchPage("result-page");
}

// 保存答题历史
function saveHistory() {
    const levelName = currentLevel === "basic" ? langData[currentLang].quizLevelBasic :
                      currentLevel === "advanced" ? langData[currentLang].quizLevelAdvanced :
                      langData[currentLang].quizLevelChallenge;
    
    historyRecords.unshift({
        level: currentLevel,
        levelName: levelName,
        score: score,
        full: questions.length * 10,
        time: new Date().toLocaleString(currentLang === "zh" ? "zh-CN" : "en-GB"),
        wrong: wrongQuestions.length
    });
    
    if (historyRecords.length > 10) historyRecords.pop();
    localStorage.setItem("quizHistory", JSON.stringify(historyRecords));
    renderHistory();
    renderNotebook();
}

// 渲染测验结果
function renderResult() {
    const full = questions.length * 10;
    document.getElementById("total-score").textContent = score;
    document.getElementById("full-score").textContent = full;
    document.getElementById("wrong-count").textContent = `${langData[currentLang].wrongCount}${wrongQuestions.length}${langData[currentLang].ti}`;
    
    const rate = score / full;
    let starNum = 0;
    let desc = "";
    if (rate >= 0.9) { starNum = 5; desc = langData[currentLang].star5; }
    else if (rate >= 0.7) { starNum = 4; desc = langData[currentLang].star4; }
    else if (rate >= 0.5) { starNum = 3; desc = langData[currentLang].star3; }
    else if (rate >= 0.3) { starNum = 2; desc = langData[currentLang].star2; }
    else { starNum = 1; desc = langData[currentLang].star1; }
    
    document.getElementById("result-desc").textContent = desc;
    document.getElementById("star-rating").innerHTML = "★".repeat(starNum) + "☆".repeat(5 - starNum);
}

// 渲染答题历史
function renderHistory() {
    const historyList = document.getElementById("history-list");
    if (historyRecords.length === 0) {
        historyList.textContent = langData[currentLang].noHistory;
        return;
    }
    
    historyList.innerHTML = historyRecords.map((record, index) => `
        <div class="notebook-item">
            <h4>${index+1}. ${record.levelName} | ${record.time}</h4>
            <p>${langData[currentLang].scoreText}：${record.score}/${record.full} | ${langData[currentLang].wrongCount}${record.wrong}${langData[currentLang].ti}</p>
        </div>
    `).join("");
}

// 渲染错题本（彻底修复题目和解析显示问题）
function renderNotebook() {
    const notebookList = document.getElementById("notebook-list");
    if (wrongNotebook.length === 0) {
        notebookList.textContent = langData[currentLang].noNotebook;
        return;
    }
    
    // 强制渲染题干、答案、解析（无undefined）
    notebookList.innerHTML = wrongNotebook.map((q, index) => {
        const title = q.title?.[currentLang] || langData[currentLang].defaultQuestion;
        const answer = q.answer || "无";
        const analysis = q.analysis?.[currentLang] || langData[currentLang].defaultAnalysis;
        
        return `
        <div class="notebook-item">
            <h4>${index+1}. ${title}</h4>
            <p style="color: var(--primary);">${langData[currentLang].rightAnswer}${answer}</p>
            <div class="analysis">${langData[currentLang].analysisText}${analysis}</div>
        </div>
    `;
    }).join("");
}

// 切换页面
function switchPage(pageId) {
    document.querySelectorAll(".page").forEach(page => page.classList.remove("active"));
    document.getElementById(pageId).classList.add("active");
}

// 数组洗牌（随机选题）
function shuffle(arr) {
    for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
}

// 更新题目计数
function updateQuestionCount() {
    document.getElementById("quiz-question-count").textContent = `${currentQuestionCount+1}/${questions.length}`;
}

// 退出测验
function quitQuiz() {
    if (confirm(langData[currentLang].quizQuit)) {
        clearInterval(countdownTimer);
        switchPage("level-selection");
    }
}

// 绑定所有事件
function bindEvents() {
    // 语言切换
    document.getElementById("lang-zh").addEventListener("click", () => switchLang("zh"));
    document.getElementById("lang-en").addEventListener("click", () => switchLang("en"));
    // 主题切换
    document.getElementById("theme-toggle").addEventListener("click", toggleTheme);
    // 字号调节
    document.getElementById("font-sm").addEventListener("click", () => setFontSize("sm"));
    document.getElementById("font-normal").addEventListener("click", () => setFontSize("normal"));
    document.getElementById("font-lg").addEventListener("click", () => setFontSize("lg"));
    // 开始测验
    document.querySelectorAll(".start-quiz-btn").forEach(btn => {
        btn.addEventListener("click", () => {
            const levelCard = btn.closest(".level-card");
            const level = levelCard.dataset.level;
            const count = parseInt(levelCard.dataset.count);
            const time = parseInt(levelCard.dataset.time);
            startQuiz(level, count, time);
        });
    });
    // 上一题/下一题
    document.getElementById("prev-question").addEventListener("click", () => changeQuestion("prev"));
    document.getElementById("next-question").addEventListener("click", () => changeQuestion("next"));
    // 提示/提交/退出
    document.getElementById("hint-btn").addEventListener("click", showHint);
    document.getElementById("submit-quiz").addEventListener("click", submitQuiz);
    document.getElementById("quit-quiz").addEventListener("click", quitQuiz);
    // 结果页面按钮
    document.getElementById("replay-quiz").addEventListener("click", () => {
        const levelCard = document.querySelector(`.level-card[data-level="${currentLevel}"]`);
        startQuiz(currentLevel, parseInt(levelCard.dataset.count), parseInt(levelCard.dataset.time));
    });
    document.getElementById("view-wrong").addEventListener("click", () => switchPage("notebook-page"));
    document.getElementById("back-to-level").addEventListener("click", () => switchPage("level-selection"));
    // 错题本按钮
    document.getElementById("back-from-notebook").addEventListener("click", () => switchPage("level-selection"));
    document.getElementById("open-notebook").addEventListener("click", () => switchPage("notebook-page"));
}
