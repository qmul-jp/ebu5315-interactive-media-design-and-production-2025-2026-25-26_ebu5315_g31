:root {
    --primary: #2563eb;
    --primary-light: #3b82f6;
    --secondary: #64748b;
    --success: #10b981;
    --warning: #f59e0b;
    --danger: #ef4444;
    --bg: #ffffff;
    --card: #f8fafc;
    --text: #1e293b;
    --text-light: #475569;
    --border: #e2e8f0;
    --correct-color: #10b981;
    --wrong-color: #ef4444;
    --shadow: 0 4px 12px rgba(0,0,0,0.08);
}
body.dark {
    --bg: #0f172a;
    --card: #1e293b;
    --text: #f1f5f9;
    --text-light: #cbd5e1;
    --border: #334155;
}
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Roboto, sans-serif;
}
body {
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    transition: all 0.3s;
}
.font-sm { font-size: 14px; }
.font-normal { font-size: 16px; }
.font-lg { font-size: 18px; }

.quiz-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 20px;
    background: var(--card);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 10;
}
.breadcrumb { color: var(--text-light); }
.breadcrumb a { color: var(--primary); text-decoration: none; }
.header-controls { display: flex; gap: 8px; }
.header-controls button {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text);
    width: 36px; height: 36px;
    border-radius: 50%;
    cursor: pointer;
    transition: 0.2s;
}
.header-controls button:hover, .header-controls button.active {
    background: var(--primary); color: white; border-color: var(--primary);
}
.lang-btn { padding: 0 12px; border-radius: 6px !important; width: auto !important; }

.quiz-container { max-width: 1000px; margin: 0 auto; padding: 20px; }
.page { display: none; }
.page.active { display: block; animation: fade 0.3s; }
@keyframes fade { from { opacity: 0; } to { opacity: 1; } }

.page-title {
    font-size: 24px;
    margin-bottom: 20px;
    text-align: center;
    color: var(--primary);
}
.rule-card, .history-card {
    background: var(--card);
    padding: 16px;
    border-radius: 10px;
    margin-bottom: 20px;
    border: 1px solid var(--border);
}
.rule-card h3, .history-card h3 {
    margin-bottom: 10px;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 8px;
}
.rule-card ul { padding-left: 20px; color: var(--text-light); }

.level-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px,1fr));
    gap: 16px;
    margin-bottom: 20px;
}
.level-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px;
    text-align: center;
    transition: 0.2s;
}
.level-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
.level-badge {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 20px;
    background: var(--primary-light);
    color: white;
    margin-bottom: 10px;
}
.level-card p { margin: 8px 0; color: var(--text-light); }
.start-quiz-btn {
    background: var(--primary);
    color: white;
    border: none;
    padding: 10px 16px;
    border-radius: 8px;
    cursor: pointer;
    margin-top: 10px;
    transition: 0.2s;
}
.start-quiz-btn:hover { background: var(--primary-light); }

.btn-primary, .btn-secondary {
    padding: 10px 18px;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: 0.2s;
}
.btn-primary { background: var(--primary); color: white; }
.btn-secondary { background: var(--card); color: var(--text); border: 1px solid var(--border); }
#open-notebook { margin: 10px 0; }

.quiz-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px;
    background: var(--card);
    border-radius: 10px;
    margin-bottom: 20px;
}
.quiz-time { font-weight: bold; color: var(--danger); }
.question-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 20px;
}
#question-title { margin-bottom: 15px; font-size: 18px; }
#answer-area { margin: 16px 0; }
.answer-option {
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    margin: 8px 0;
    cursor: pointer;
    transition: 0.2s;
}
.answer-option:hover { background: var(--border); }
.answer-option.selected { background: var(--primary-light); color: white; border-color: var(--primary); }
.answer-option.correct { background: var(--success); color: white; }
.answer-option.wrong { background: var(--danger); color: white; }
.answer-input {
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    width: 100%;
    margin-top: 8px;
    background: var(--bg);
    color: var(--text);
}
.submit-answer-btn {
    padding: 8px 14px;
    background: var(--primary);
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
}
.hint-btn {
    background: var(--warning);
    color: white;
    border: none;
    padding: 8px 14px;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 10px 0;
}
.hint-content {
    padding: 12px;
    background: #fffbeb;
    color: #92400e;
    border-radius: 8px;
    margin: 10px 0;
    display: none;
}
.hint-content.show { display: block; }
#answer-feedback { font-weight: 500; }

.quiz-nav {
    display: flex;
    justify-content: space-between;
    margin-top: 20px;
}
.btn-nav {
    padding: 10px 16px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--card);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
}
.btn-nav:disabled { opacity: 0.5; cursor: not-allowed; }

.result-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 30px;
    text-align: center;
    margin-bottom: 20px;
}
.score-box { font-size: 36px; font-weight: bold; color: var(--primary); margin-bottom: 10px; }
.star-box { font-size: 24px; color: var(--warning); margin: 10px 0; }
.result-desc { color: var(--text-light); margin: 10px 0; }
.result-btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

.back-btn { margin-bottom: 20px; }
.notebook-item {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 16px;
    margin-bottom: 12px;
}
.notebook-item h4 { margin-bottom: 8px; }
.analysis { color: var(--text-light); margin-top: 8px; }

.quiz-footer {
    margin-top: 40px;
    padding: 20px;
    text-align: center;
    border-top: 1px solid var(--border);
    color: var(--text-light);
}
.ad-banner { margin-bottom: 10px; color: var(--primary); }

@media (max-width:768px) {
    .quiz-header { flex-direction: column; gap: 10px; }
    .level-cards { grid-template-columns: 1fr; }
    .quiz-header-bar { flex-direction: column; gap: 10px; }
    .quiz-nav { flex-direction: column; gap: 10px; }
}
